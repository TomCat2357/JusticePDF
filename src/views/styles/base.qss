/* =========================================================================
 * JusticePDF — 全体の見た目（Justice Desk 標準テーマに合わせる）
 * 色は slate-300 などの名前を「アットマーク」で挟んだ印で書き、theme.load_app_stylesheet() が実際の色へ置き換える。
 * 領域ごとに base / library / page_edit / panels の 4 ファイルへ分けてある。
 * ここ(base)は全体・ダイアログ・入力欄・メニュー・ツールチップ・スクロールバー・
 * プログレスバー・ラバーバンド。
 * ========================================================================= */

/* ---------- Global ------------------------------------------------------- */

* {
    font-family: "Noto Sans JP", "Yu Gothic UI", "Meiryo UI", sans-serif;
    font-size: 13px;
    color: @slate-800@;
}

QMainWindow,
QWidget {
    background-color: @slate-100@;
}

/* Disabled look for buttons / inputs outside the toolbar (side drawers etc.).
   Toolbar buttons keep their own, more specific rules in library.qss. */
QPushButton:disabled { color: @slate-400@; }
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled { background-color: @slate-100@; color: @slate-400@; border: 1px solid @slate-200@; }
QListWidget:disabled,
QTreeWidget:disabled { background-color: @slate-100@; color: @slate-400@; }

/* Side-panel toggle buttons (e.g. 図形 shape selector) */
QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 18px;
    font-size: 12px;
    font-weight: 500;
    color: @slate-800@;
}
QToolButton:hover            { background-color: @slate-200@; }
QToolButton:pressed          { background-color: @slate-300@; }
QToolButton:checked          { background-color: @slate-300@; border: 1px solid @slate-400@; }
QToolButton:checked:hover    { background-color: @slate-300@; }
QToolButton:disabled         { color: @slate-400@; }
QToolButton:focus            { outline: none; }

/* ---------- Scroll bars -------------------------------------------------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: @slate-300@;
    border-radius: 4px;
    min-height: 28px;
}
QScrollBar::handle:vertical:hover { background: @slate-400@; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; background: none; border: none; }
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: @slate-300@;
    border-radius: 4px;
    min-width: 28px;
}
QScrollBar::handle:horizontal:hover { background: @slate-400@; }
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal { width: 0; background: none; border: none; }

/* ---------- Dialogs / forms (ExportOptionsDialog etc.) ------------------ */

QDialog {
    background-color: @white@;
}

QLabel { color: @slate-800@; background-color: transparent; }

QLineEdit,
QPlainTextEdit,
QTextEdit {
    background-color: @white@;
    border: 1px solid @slate-300@;
    border-radius: 4px;
    padding: 6px 8px;
    selection-background-color: @blue-100@;
    selection-color: @slate-800@;
}
QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus {
    border: 1px solid @blue-500@;
}
QLineEdit:disabled,
QPlainTextEdit:disabled { background-color: @slate-100@; color: @slate-400@; }

QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: @white@;
    border: 1px solid @slate-300@;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 22px;
}
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus { border: 1px solid @blue-500@; }

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    width: 18px;
    border: none;
    background: transparent;
}
QSpinBox::up-button,   QDoubleSpinBox::up-button   { subcontrol-position: top right; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-position: bottom right; }
QSpinBox::up-button:hover,   QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover   { background: @slate-100@; }
QSpinBox::up-button:pressed,   QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed { background: @slate-200@; }

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: none;
    width: 0; height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid @slate-500@;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: none;
    width: 0; height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid @slate-500@;
}
QSpinBox::up-arrow:disabled,   QDoubleSpinBox::up-arrow:disabled,
QSpinBox::up-arrow:off,        QDoubleSpinBox::up-arrow:off        { border-bottom-color: @slate-300@; }
QSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:disabled,
QSpinBox::down-arrow:off,      QDoubleSpinBox::down-arrow:off      { border-top-color: @slate-300@; }

QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid @slate-500@;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    background-color: @white@;
    border: 1px solid @slate-300@;
    border-radius: 4px;
    selection-background-color: @blue-50@;
    selection-color: @slate-800@;
    padding: 2px;
    outline: none;
}

QCheckBox { spacing: 6px; color: @slate-800@; }
QCheckBox::indicator {
    width: 14px; height: 14px;
    border: 1px solid @slate-300@;
    border-radius: 3px;
    background-color: @white@;
}
QCheckBox::indicator:hover    { border: 1px solid @blue-600@; }
QCheckBox::indicator:checked  {
    background-color: @blue-600@;
    border: 1px solid @blue-600@;
    image: none;
}
QCheckBox::indicator:disabled { background-color: @slate-100@; border-color: @slate-200@; }

QRadioButton { spacing: 6px; color: @slate-800@; }
QRadioButton::indicator {
    width: 14px; height: 14px;
    border: 1px solid @slate-300@;
    border-radius: 8px;
    background-color: @white@;
}
QRadioButton::indicator:hover { border: 1px solid @blue-600@; }
QRadioButton::indicator:checked {
    border: 1px solid @blue-600@;
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
        stop:0 @blue-600@, stop:0.45 @blue-600@, stop:0.5 @white@, stop:1 @white@);
}
QRadioButton::indicator:disabled { background-color: @slate-100@; border-color: @slate-200@; }
QRadioButton:disabled { color: @slate-400@; }

/* Sliders (quality sliders in export dialog) */
QSlider::groove:horizontal {
    height: 4px;
    background: @slate-200@;
    border-radius: 2px;
}
QSlider::sub-page:horizontal { background: @blue-600@; border-radius: 2px; }
QSlider::handle:horizontal {
    background: @white@;
    border: 1px solid @blue-600@;
    width: 14px; height: 14px;
    margin: -6px 0;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover  { background: @blue-50@; }
QSlider::groove:horizontal:disabled { background: @slate-100@; }
QSlider::sub-page:horizontal:disabled { background: @slate-300@; }
QSlider::handle:horizontal:disabled { background: @slate-100@; border-color: @slate-300@; }

/* ---------- Dialog buttons (QDialogButtonBox / QPushButton) ------------- */

QDialog QPushButton {
    background-color: @white@;
    border: 1px solid @slate-300@;
    border-radius: 4px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 500;
    color: @slate-800@;
    min-width: 72px;
}
QDialog QPushButton:hover   { background-color: @slate-100@; }
QDialog QPushButton:pressed { background-color: @slate-200@; }
QDialog QPushButton:default {
    background-color: @blue-600@;
    color: @white@;
    border: 1px solid @blue-600@;
}
QDialog QPushButton:default:hover   { background-color: @blue-700@; }
QDialog QPushButton:default:pressed { background-color: @blue-800@; }

/* ---------- Menus / Context menus --------------------------------------- */

QMenu {
    background-color: @white@;
    border: 1px solid @slate-300@;
    border-radius: 4px;
    padding: 4px 0;
}
QMenu::item {
    padding: 5px 16px 5px 10px;
    color: @slate-800@;
    font-size: 12px;
}
QMenu::item:selected { background-color: @blue-50@; color: @slate-800@; }
QMenu::item:disabled { color: @slate-400@; background-color: transparent; }
QMenu::icon { padding-left: 4px; }
QMenu::separator {
    height: 1px; background-color: @slate-200@; margin: 4px 0;
}

/* ---------- Tooltip ------------------------------------------------------ */

QToolTip {
    background-color: @slate-800@;
    color: @white@;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

/* ---------- Status bar / Message boxes ---------------------------------- */

QStatusBar {
    background-color: @slate-50@;
    border-top: 1px solid @slate-300@;
    color: @slate-500@;
    font-size: 11px;
}
QStatusBar::item { border: none; }

QMessageBox { background-color: @white@; }

/* ---------- Progress dialog --------------------------------------------- */

QProgressBar {
    background-color: @slate-200@;
    border: none;
    border-radius: 4px;
    height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: @blue-600@;
    border-radius: 4px;
}

/* ---------- Rubber band (selection marquee) ----------------------------- */

QRubberBand {
    border: 1px solid @blue-500@;
    background-color: @rubber-fill@;
}

/* ステータスバー内のラベル（地を透かし、11px の灰色） */
QStatusBar QLabel {
    background-color: transparent;
    color: @slate-500@;
    font-size: 11px;
}
QStatusBar QLabel#statusBusy { color: @blue-600@; }
